# Narrow compatibility build: retain the deployed runtime and locked dependencies.
# The operator script supplies the digest of MMRF's deployed f87a2ab image.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
LABEL org.opencontainers.image.source="https://github.com/theMMRF/gen3-analysis"
WORKDIR /gen3analysis
COPY --chown=gen3:gen3 gen3analysis/auth.py gen3analysis/settings.py /gen3analysis/gen3analysis/
USER gen3
